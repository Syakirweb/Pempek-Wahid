rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Koleksi Produk: Dapat dibaca publik, hanya Admin terautentikasi yang dapat mengubah/menambah/menghapus
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Koleksi Ulasan: Dapat dibaca dan dibuat oleh publik, hanya Admin terautentikasi yang dapat mengubah/menghapus
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

  }
}
